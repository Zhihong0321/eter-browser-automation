# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Fast worker — a small, cheap model for low-reasoning jobs.
# Optional: the engine runs fine without it. The scanner uses no model at all.
#
# Any OpenAI-compatible chat-completions endpoint works. The key is optional
# here: it falls back to STEPFUN_API_KEY below, so one account key covers both
# surfaces. Set it only to point the fast worker at a different provider.
FASTWORKER_API_KEY=
FASTWORKER_BASE_URL=https://api.example.com/v1
FASTWORKER_MODEL=

# Claude Agent SDK connection profiles (src/agent.ts). One block per provider,
# selected with --profile <id>. Any host serving POST /v1/messages in Anthropic
# wire format works; leave the /v1 off the base URL, the SDK appends it.
# Only the key is mandatory — URL and model fall back to the values shown.

# --profile stepfun  (the default)
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.ai/step_plan
STEPFUN_MODEL=step-3.7-flash

# --profile kimi — a proxy serving both the OpenAI and the Anthropic surface.
# Note the base URL has NO trailing /v1, even though the provider documents one:
# the SDK appends /v1/messages itself, and /v1/v1/messages 404s.
KIMI_API_KEY=
KIMI_BASE_URL=https://api2.cmkey.cn
KIMI_MODEL=kimi-k3

# Google PageSpeed Insights, for the website benchmark in the gmap deep-research
# pipeline. Two ways to authenticate; either one is enough, and the API key wins
# when both are present because it costs no token round-trip.
#
#   1. An API key — enable "PageSpeed Insights API" in a Google Cloud project,
#      then Credentials → Create credentials → API key. 25,000 queries/day free.
#   2. A service-account JSON key, which the repo reads from
#      .secrets/pagespeed-sa.json by default (gitignored). Override the path with
#      PAGESPEED_SA_KEY_FILE. NOTE: PSI accepts exactly one OAuth scope, `openid`
#      — a token minted for cloud-platform is rejected 403 (measured 2026-08-17).
#
# Strongly recommended. Without either, the stage still runs but falls back to
# benchmarking in our own Chromium, which yields an ESTIMATED performance score and
# no real-user CrUX data. Anonymous PSI is not a fallback: every unauthenticated
# caller shares one Google project whose daily quota is already spent (measured
# 2026-08-17 — HTTP 429 in 560ms on the first call of the day).
PAGESPEED_API_KEY=
PAGESPEED_SA_KEY_FILE=

# --- RAG Bucket (company knowledge hosting) --------------------------------------
# Markdown knowledge buckets, one group per company, published for AI retrieval.
# Falls back to the "EE_HTML_HOSTING_SERVICE" credential in D:/tools/my-vault when
# unset. NOTE: every document uploaded to a group is PUBLICLY readable at
# /r/<group>/docs/<file> with no auth, and robots.txt invites ChatGPT crawlers --
# there is no private document on this service.
RAG_BUCKET_API_KEY=
# Override only to target a different bucket. The service's own docs print
# "rag-b.up-railway.app", which does not resolve; the working host has a dot.
RAG_BUCKET_URL=https://rag-b.up.railway.app
