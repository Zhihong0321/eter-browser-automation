# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Fast worker — a small, cheap model for low-reasoning jobs.
# Optional: the engine runs fine without it. The scanner uses no model at all.
#
# Any OpenAI-compatible chat-completions endpoint works. The key is optional
# here: it falls back to STEPFUN_API_KEY below, so one account key covers both
# surfaces. Set it only to point the fast worker at a different provider.
FASTWORKER_API_KEY=
FASTWORKER_BASE_URL=https://api.example.com/v1
FASTWORKER_MODEL=

# Claude Agent SDK — StepFun's Anthropic-compatible Messages API.
# Used by src/agent.ts. Any host serving POST /v1/messages in Anthropic wire
# format works; leave the /v1 off the base URL, the SDK appends /v1/messages.
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.ai/step_plan
STEPFUN_MODEL=step-3.7-flash
