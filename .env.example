# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Fast worker — a small, cheap model for low-reasoning jobs.
# Optional: the engine runs fine without it. The scanner uses no model at all.
#
# Any OpenAI-compatible chat-completions endpoint works.
FASTWORKER_API_KEY=
FASTWORKER_BASE_URL=https://api.example.com/v1
FASTWORKER_MODEL=
