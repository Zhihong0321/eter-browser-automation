{
  "name": "eter-browser",
  "version": "0.1.0",
  "description": "Share your real browser login sessions with any AI agent. Local session vault + dashboard + MCP server.",
  "type": "module",
  "bin": {
    "eter-browser": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-ui.mjs",
    "ui": "npm run build && node dist/cli.js ui",
    "mcp": "node dist/cli.js mcp",
    "test": "tsx --test --test-concurrency=2 test/*.test.ts",
    "start": "node dist/cli.js ui"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.228",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "patchright": "^1.61.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
