node_modules/
dist/
*.log
# Daemon stdout capture — runtime artifact, and it prints the local vault path.
.daemon.out
.daemon.err

# Never commit browser profiles — they contain live login sessions.
profiles/
.eter-browser/
screenshots/
manifest.json

# fb-recon's harvest is a list of identified people collected for outreach.
# PDPA applies to it — it must never leave this machine in a repo.
# Root-anchored on purpose: an unanchored "fb-recon/" also matches src/fb-recon/
# and would silently untrack the entire module.
/fb-recon/
contacts.csv
contacts.json

# API keys. This project may be published; secrets live here and nowhere else.
.env
.env.*
!.env.example

# Service-account key files (Google JSON keys). Same rule as .env: a published
# repo must never carry a private key, and these arrive as whole files rather
# than as a line in .env, so they need their own home.
.secrets/

# Repo-local Claude home for the Agent SDK (src/agent.ts) — never commit.
.agent-home/

# Python venv holding notebooklm-py (the NotebookLM MCP server). Machine-local
# binaries, ~200MB; rebuilt from docs/notebooklm-setup.md.
.venv-notebooklm/

# Diffs and temporary audits
*.diff
.legion-autocount-report-audit.json

