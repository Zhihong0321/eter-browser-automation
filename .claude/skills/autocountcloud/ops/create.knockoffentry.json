{
  "op": "create.knockoffentry",
  "table": "knockoffentry",
  "needs": [
    {
      "field": "knockoffentry.f.customer_supplier_code",
      "ask_user_for": "Customer/Supplier Code",
      "control": "dropdown",
      "pick_from_table": "debtor"
    },
    {
      "field": "knockoffentry.f.knock_off_no",
      "ask_user_for": "Knock Off No.",
      "control": "dropdown",
      "note": "server-assigned, do not supply"
    },
    {
      "field": "knockoffentry.f.company_name",
      "ask_user_for": "Company Name",
      "control": "input"
    },
    {
      "field": "knockoffentry.f.currency_code",
      "ask_user_for": "Currency Code",
      "control": "input",
      "pick_from_table": "currency"
    },
    {
      "field": "knockoffentry.f.date",
      "ask_user_for": "Date",
      "control": "date picker"
    },
    {
      "field": "knockoffentry.f.search",
      "ask_user_for": "Search",
      "control": "input"
    },
    {
      "field": "knockoffentry.f.total_applied_amount",
      "ask_user_for": "Total Applied Amount",
      "control": "input"
    },
    {
      "field": "knockoffentry.f.gain_loss",
      "ask_user_for": "Gain/(Loss)",
      "control": "input"
    }
  ],
  "steps": [
    "navigate to /knockoffentry",
    "click \"New\"",
    "fill \"Customer/Supplier Code\" -> body>div:nth-of-type(2)>div>div:nth-of-type(1)>div>div>div>div:nth-of-type(2)>form>div:nth-of-type(1)>div:nth-of-type(1)>div:nth-of-type(1)>div>div>div>div>div:nth-of-type(1)>input",
    "fill \"Knock Off No.\" -> body>div:nth-of-type(2)>div>div:nth-of-type(1)>div>div>div>div:nth-of-type(2)>form>div:nth-of-type(1)>div:nth-of-type(2)>div:nth-of-type(1)>div>div:nth-of-type(1)>div:nth-of-type(2)>div:nth-of-type(1)>input",
    "fill \"Company Name\" -> body>div:nth-of-type(2)>div>div:nth-of-type(1)>div>div>div>div:nth-of-type(2)>form>div:nth-of-type(1)>div:nth-of-type(1)>div:nth-of-type(2)>div:nth-of-type(1)>div>div>div:nth-of-type(1)>input",
    "fill \"Currency Code\" -> body>div:nth-of-type(2)>div>div:nth-of-type(1)>div>div>div>div:nth-of-type(2)>form>div:nth-of-type(1)>div:nth-of-type(1)>div:nth-of-type(2)>div:nth-of-type(2)>div>div>div:nth-of-type(1)>input",
    "fill \"Date\" -> body>div:nth-of-type(2)>div>div:nth-of-type(1)>div>div>div>div:nth-of-type(2)>form>div:nth-of-type(1)>div:nth-of-type(2)>div:nth-of-type(2)>div>div>div>div:nth-of-type(1)>input",
    "fill \"Search\" -> body>div:nth-of-type(2)>div>div:nth-of-type(1)>div>div>div>div:nth-of-type(2)>form>div:nth-of-type(2)>div>div>div:nth-of-type(4)>div>div>div:nth-of-type(3)>div:nth-of-type(6)>div>div>div>div:nth-of-type(1)>input",
    "fill \"Total Applied Amount\" -> body>div:nth-of-type(2)>div>div:nth-of-type(1)>div>div>div>div:nth-of-type(2)>form>div:nth-of-type(3)>div>div>div>div:nth-of-type(1)>input",
    "fill \"Gain/(Loss)\" -> body>div:nth-of-type(2)>div>div:nth-of-type(1)>div>div>div>div:nth-of-type(2)>form>div:nth-of-type(4)>div>div>div>div:nth-of-type(1)>input",
    "click \"Save\"",
    "verify: the new row appears in the knockoffentry grid"
  ]
}