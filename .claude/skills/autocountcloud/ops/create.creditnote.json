{
  "op": "create.creditnote",
  "table": "creditnote",
  "needs": [
    {
      "field": "creditnote.f.customer",
      "ask_user_for": "Customer",
      "control": "dropdown",
      "pick_from_table": "debtor"
    },
    {
      "field": "creditnote.f.name",
      "ask_user_for": "Name",
      "control": "input"
    },
    {
      "field": "creditnote.f.email",
      "ask_user_for": "Email",
      "control": "input"
    },
    {
      "field": "creditnote.f.c_n_no",
      "ask_user_for": "C/N No.",
      "control": "dropdown",
      "note": "server-assigned, do not supply"
    },
    {
      "field": "creditnote.f.address",
      "ask_user_for": "Address",
      "control": "text area"
    },
    {
      "field": "creditnote.f.sales_agent",
      "ask_user_for": "Sales Agent",
      "control": "dropdown",
      "pick_from_table": "salesagent"
    },
    {
      "field": "creditnote.f.our_invoice_no",
      "ask_user_for": "Our Invoice No.",
      "control": "input",
      "pick_from_table": "invoice",
      "note": "server-assigned, do not supply"
    },
    {
      "field": "creditnote.f.date",
      "ask_user_for": "Date",
      "control": "date picker"
    },
    {
      "field": "creditnote.f.reason",
      "ask_user_for": "Reason",
      "control": "text area"
    },
    {
      "field": "creditnote.f.currency",
      "ask_user_for": "Currency",
      "control": "dropdown",
      "pick_from_table": "currency"
    },
    {
      "field": "creditnote.f.rate",
      "ask_user_for": "Rate",
      "control": "input"
    }
  ],
  "steps": [
    "navigate to /creditnote",
    "click \"New\"",
    "fill \"Customer\" -> body>div:nth-of-type(2)>div>div:nth-of-type(1)>div>div>div>div:nth-of-type(2)>form>div:nth-of-type(1)>div:nth-of-type(1)>div>div:nth-of-type(1)>div>div>div>div:nth-of-type(1)>input",
    "fill \"Name\" -> body>div:nth-of-type(2)>div>div:nth-of-type(1)>div>div>div>div:nth-of-type(2)>form>div:nth-of-type(1)>div:nth-of-type(1)>div>div:nth-of-type(2)>div>div:nth-of-type(2)>div:nth-of-type(1)>input",
    "fill \"Email\" -> body>div:nth-of-type(2)>div>div:nth-of-type(1)>div>div>div>div:nth-of-type(2)>form>div:nth-of-type(1)>div:nth-of-type(2)>div:nth-of-type(1)>div>div:nth-of-type(1)>input",
    "fill \"C/N No.\" -> body>div:nth-of-type(2)>div>div:nth-of-type(1)>div>div>div>div:nth-of-type(2)>form>div:nth-of-type(1)>div:nth-of-type(3)>div>div:nth-of-type(1)>div:nth-of-type(2)>div:nth-of-type(1)>input",
    "fill \"Address\" -> body>div:nth-of-type(2)>div>div:nth-of-type(1)>div>div>div>div:nth-of-type(2)>form>div:nth-of-type(2)>div:nth-of-type(1)>div>div>div:nth-of-type(1)>textarea",
    "fill \"Sales Agent\" -> body>div:nth-of-type(2)>div>div:nth-of-type(1)>div>div>div>div:nth-of-type(2)>form>div:nth-of-type(2)>div:nth-of-type(2)>div:nth-of-type(1)>div:nth-of-type(1)>div>div>div>div:nth-of-type(1)>input",
    "fill \"Our Invoice No.\" -> body>div:nth-of-type(2)>div>div:nth-of-type(1)>div>div>div>div:nth-of-type(2)>form>div:nth-of-type(2)>div:nth-of-type(2)>div:nth-of-type(1)>div:nth-of-type(2)>div>div>div:nth-of-type(1)>input",
    "fill \"Date\" -> body>div:nth-of-type(2)>div>div:nth-of-type(1)>div>div>div>div:nth-of-type(2)>form>div:nth-of-type(2)>div:nth-of-type(3)>div>div>div>div>div:nth-of-type(1)>input",
    "fill \"Reason\" -> body>div:nth-of-type(2)>div>div:nth-of-type(1)>div>div>div>div:nth-of-type(2)>form>div:nth-of-type(2)>div:nth-of-type(2)>div:nth-of-type(2)>div>div>div:nth-of-type(1)>input",
    "fill \"Currency\" -> body>div:nth-of-type(2)>div>div:nth-of-type(1)>div>div>div>div:nth-of-type(2)>form>div:nth-of-type(3)>div>div:nth-of-type(2)>div:nth-of-type(2)>div>div:nth-of-type(2)>div>div:nth-of-type(1)>input",
    "fill \"Rate\" -> body>div:nth-of-type(2)>div>div:nth-of-type(1)>div>div>div>div:nth-of-type(2)>form>div:nth-of-type(3)>div>div:nth-of-type(2)>div:nth-of-type(2)>div>div:nth-of-type(4)>div>div:nth-of-type(2)>div:nth-of-type(1)>input",
    "click \"Save\"",
    "verify: the new row appears in the creditnote grid"
  ]
}